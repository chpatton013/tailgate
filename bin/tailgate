#!/usr/bin/env bash
# tailgate — run the Tailscale client in a container and reach your tailnet from the host.
#
#   tailgate up             start the client (SOCKS5 + HTTP proxy on loopback; mode via TS_MODE in .env)
#   tailgate down           stop and remove the container
#   tailgate status         tailscale status (from inside the container)
#   tailgate ip             this node's tailnet IP(s)
#   tailgate logs           follow container logs
#   tailgate ssh <host> ... ssh to a tailnet node through the SOCKS5 proxy
#   tailgate curl <args>    curl through the SOCKS5 proxy (remote DNS = MagicDNS works)
#   tailgate forward [user@]host <rport> [lport] [ssh args]   forward a node's loopback port
#   tailgate proxy          print proxy addresses + shell export hints
#   tailgate doctor         diagnose the setup end to end
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# Docker Compose parses .env without executing it. Tests and automation can
# point at another file without reading or evaluating the local secret.
ENV_FILE="${TAILGATE_ENV_FILE:-.env}"
COMPOSE_ARGS=(compose)
if [[ -n "${TAILGATE_ENV_FILE+x}" || -f "$ENV_FILE" ]]; then
  COMPOSE_ARGS+=(--env-file "$ENV_FILE")
fi

compose() { docker "${COMPOSE_ARGS[@]}" "$@"; }

COMPOSE_ENV=""
if command -v docker >/dev/null 2>&1; then
  COMPOSE_ENV="$(compose config --environment 2>/dev/null || true)"
fi

config_value() {
  local key="$1" line
  while IFS= read -r line; do
    if [[ "$line" == "$key="* ]]; then
      printf '%s' "${line#*=}"
      return 0
    fi
  done <<<"$COMPOSE_ENV"
  return 1
}

resolved_config() {
  local key="$1" inherited="$2" fallback="$3" value
  if value="$(config_value "$key")" && [[ -n "$value" ]]; then
    printf '%s' "$value"
  elif [[ -n "$inherited" ]]; then
    printf '%s' "$inherited"
  else
    printf '%s' "$fallback"
  fi
}

SOCKS5_PORT="$(resolved_config TS_SOCKS5_PORT "${TS_SOCKS5_PORT-}" 1055)"
HTTP_PROXY_PORT="$(resolved_config TS_HTTP_PROXY_PORT "${TS_HTTP_PROXY_PORT-}" 1056)"
LOGIN_SERVER="$(resolved_config TS_LOGIN_SERVER "${TS_LOGIN_SERVER-}" https://headscale.example.com)"
TS_MODE="$(resolved_config TS_MODE "${TS_MODE-}" userspace)"
TAILNET_SUFFIX="$(resolved_config TAILGATE_TAILNET_SUFFIX "${TAILGATE_TAILNET_SUFFIX-}" ts.example.com)"
DNS_TEST_NAME="$(resolved_config TAILGATE_DNS_TEST_NAME "${TAILGATE_DNS_TEST_NAME-}" '')"
FORCE_DERP="$(resolved_config TS_DEBUG_ALWAYS_USE_DERP "${TS_DEBUG_ALWAYS_USE_DERP-}" false)"
AUTHKEY="$(resolved_config TS_AUTHKEY "${TS_AUTHKEY-}" '')"
case "$TS_MODE" in
  userspace|kernel) ;;
  *) echo "invalid TS_MODE '$TS_MODE' (must be 'userspace' or 'kernel')" >&2; exit 1;;
esac
case "$FORCE_DERP" in
  true|false) ;;
  *) echo "invalid TS_DEBUG_ALWAYS_USE_DERP '$FORCE_DERP' (must be 'true' or 'false')" >&2; exit 1;;
esac
SOCKS5_ADDR="127.0.0.1:${SOCKS5_PORT}"
# Selects which compose service (and thus which profile) runs — the two modes
# are mutually exclusive, never both up at once. See compose.yaml for the tradeoffs.
SERVICE="tailscale-${TS_MODE}"
export COMPOSE_PROFILES="${TS_MODE}"

err()  { printf '\033[31m%s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[32m%s\033[0m\n' "$*"; }
info() { printf '%s\n' "$*"; }

require_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    err "No configuration found. Run:  cp .env.example .env  &&  ./bin/mint-authkey --write-env"
    exit 1
  fi
  if [[ -z "$AUTHKEY" ]]; then
    err "TS_AUTHKEY is empty. Run:  ./bin/mint-authkey --write-env"
    exit 1
  fi
}

cmd_up() {
  require_env
  info "Starting tailgate (${TS_MODE} mode — SOCKS5 ${SOCKS5_ADDR}, HTTP 127.0.0.1:${HTTP_PROXY_PORT})"
  [[ "$TS_MODE" == "kernel" ]] && info "kernel mode is EXPERIMENTAL — see the note at the top of compose.yaml"
  compose up -d
  info "Watch registration with:  tailgate logs    (Ctrl-C to stop watching)"
}

cmd_down()   { compose down "$@"; }
cmd_logs()   { compose logs -f "$SERVICE"; }
cmd_status() { compose exec "$SERVICE" tailscale status "$@"; }
cmd_ip()     { compose exec "$SERVICE" tailscale ip "$@"; }

cmd_ssh() {
  if [[ $# -lt 1 ]]; then err "usage: tailgate ssh <host> [ssh args...]"; exit 1; fi
  # nc -X 5 -x <proxy> performs SOCKS5; the hostname is resolved at the proxy,
  # so MagicDNS names (*.ts.example.com) work. If your nc resolves locally,
  # pass the 100.x address instead.
  ssh -o ProxyCommand="nc -X 5 -x ${SOCKS5_ADDR} %h %p" "$@"
}

cmd_curl() {
  curl --proxy "socks5h://${SOCKS5_ADDR}" "$@"
}

cmd_forward() {
  # Forward a tailnet node's loopback-bound port to the host, tunneled through
  # the SOCKS5 proxy. For services that bind to 127.0.0.1 on the node (e.g.
  # myhost's gateway on 8000) and so aren't reachable over the tailnet directly.
  #
  # Host is [user@]host, exactly like ssh: a bare alias resolves via ~/.ssh/config,
  # or give user@host plus any ssh flags (e.g. -i key) and need no config at all.
  #
  #   tailgate forward myhost 8000
  #   tailgate forward user@myhost.ts.example.com 8000 -i ~/.ssh/id_ed25519
  #   tailgate forward myhost 8000 28789 -i ~/.ssh/key   # local port 28789
  if [[ $# -lt 2 ]]; then
    err "usage: tailgate forward [user@]host <remote-port> [local-port] [ssh args...]"; exit 1
  fi
  local host="$1"; shift
  local rport="$1"; shift
  if ! [[ "$rport" =~ ^[0-9]+$ ]]; then
    err "remote-port must be numeric (got '$rport')"; exit 1
  fi
  local lport="$rport"
  # An optional numeric next arg is the local port; anything starting with '-'
  # (or non-numeric) is left for ssh.
  if [[ "${1:-}" =~ ^[0-9]+$ ]]; then lport="$1"; shift; fi
  info "Forwarding http://localhost:${lport}  ->  ${host}:127.0.0.1:${rport}  (Ctrl-C to stop)"
  # Remaining "$@" are passthrough ssh args; host goes last.
  ssh -N -o ExitOnForwardFailure=yes \
    -o ProxyCommand="nc -X 5 -x ${SOCKS5_ADDR} %h %p" \
    -L "${lport}:127.0.0.1:${rport}" "$@" "$host"
}

cmd_proxy() {
  cat <<EOF
SOCKS5 proxy : socks5h://${SOCKS5_ADDR}
HTTP proxy   : http://127.0.0.1:${HTTP_PROXY_PORT}
               (tailscaled backend; Headscale extra records require SOCKS5)

Shell (curl, git, etc. — remote DNS via SOCKS):
  unset HTTPS_PROXY https_proxy
  export ALL_PROXY=socks5h://${SOCKS5_ADDR}

Browser (Firefox profile): SOCKS5 host 127.0.0.1 port ${SOCKS5_PORT},
  and enable "Proxy DNS when using SOCKS v5".

SSH (~/.ssh/config):
  Host *.${TAILNET_SUFFIX} 100.64.*
    ProxyCommand nc -X 5 -x ${SOCKS5_ADDR} %h %p
EOF
}

cmd_doctor() {
  local fail=0 container_running=false
  command -v docker >/dev/null && ok "✓ docker present" || { err "✗ docker not found"; fail=1; }
  if [[ -f "$ENV_FILE" ]] && [[ -n "$AUTHKEY" ]]; then ok "✓ configuration has TS_AUTHKEY"
  else err "✗ configuration missing or TS_AUTHKEY empty"; fail=1; fi

  info "mode: ${TS_MODE}"
  if [[ "$FORCE_DERP" == "true" ]]; then
    info "forced DERP enabled (debug setting; relay latency applies)"
  fi

  if docker ps --format '{{.Names}}' | grep -qx tailgate; then
    container_running=true
    ok "✓ container 'tailgate' running"
  else
    err "✗ container not running (try: tailgate up)"; fail=1
  fi

  if [[ "$container_running" == "true" ]]; then
    if compose exec -T "$SERVICE" sh -c 'pidof tailgate-socks >/dev/null && pidof tailscaled >/dev/null'; then
      ok "✓ tailgate processes running"
    else
      err "✗ tailgate processes are not healthy (check: tailgate logs)"; fail=1
    fi

    if compose exec -T "$SERVICE" tailscale status --json 2>/dev/null \
      | grep -Eq '"BackendState"[[:space:]]*:[[:space:]]*"Running"'; then
      ok "✓ node registered to ${LOGIN_SERVER}"
      compose exec -T "$SERVICE" tailscale ip 2>/dev/null | sed 's/^/    ip: /' || true
    else
      err "✗ tailscale not registered yet (check: tailgate logs)"; fail=1
    fi

    if compose exec -T "$SERVICE" nc -z 127.0.0.1 1057 >/dev/null 2>&1; then
      ok "✓ tailscaled SOCKS backend reachable on 127.0.0.1:1057"
    else
      err "✗ tailscaled SOCKS backend not reachable on 127.0.0.1:1057"; fail=1
    fi

    if [[ -n "$DNS_TEST_NAME" ]]; then
      if compose exec -T "$SERVICE" tailgate-socks --resolve "$DNS_TEST_NAME" >/dev/null 2>&1; then
        ok "✓ internal alias resolves: ${DNS_TEST_NAME}"
      else
        err "✗ internal alias does not resolve: ${DNS_TEST_NAME}"; fail=1
      fi
    else
      info "internal alias check skipped (set TAILGATE_DNS_TEST_NAME to enable)"
    fi
  fi

  if nc -z 127.0.0.1 "${SOCKS5_PORT}" 2>/dev/null; then
    ok "✓ DNS-aware SOCKS shim reachable on ${SOCKS5_ADDR}"
  else
    err "✗ DNS-aware SOCKS shim not reachable on ${SOCKS5_ADDR}"; fail=1
  fi

  [[ $fail -eq 0 ]] && ok "doctor: all good" || { err "doctor: problems found"; return 1; }
}

usage() { sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    up)      cmd_up "$@";;
    down)    cmd_down "$@";;
    status)  cmd_status "$@";;
    ip)      cmd_ip "$@";;
    logs)    cmd_logs "$@";;
    ssh)     cmd_ssh "$@";;
    curl)    cmd_curl "$@";;
    forward) cmd_forward "$@";;
    proxy)   cmd_proxy "$@";;
    doctor)  cmd_doctor "$@";;
    ""|-h|--help|help) usage;;
    *) err "unknown command: $sub"; usage; exit 1;;
  esac
}

main "$@"
