#!/usr/bin/env bash
# tailgate — run the Tailscale client in a container and reach your tailnet from the host.
#
#   tailgate up             start the client (SOCKS5 + HTTP proxy on loopback; mode via TS_MODE in .env)
#   tailgate down           stop and remove the container
#   tailgate status         tailscale status (from inside the container)
#   tailgate ip             this node's tailnet IP(s)
#   tailgate logs           follow container logs
#   tailgate ssh [ssh args...] <host> ssh to a tailnet node through the SOCKS5 proxy
#   tailgate curl <args>    curl through the SOCKS5 proxy (remote DNS = MagicDNS works)
#   tailgate forward [user@]host [<remote-addr>:]<remote-port> [[<local-addr>:]local-port] [ssh args]
#                         forward a remote service to a local listener
#   tailgate proxy          print proxy addresses + shell export hints
#   tailgate doctor         diagnose the setup end to end
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# Docker Compose parses .env without executing it. Tests and automation can
# point at another file without reading or evaluating the local secret.
ENV_FILE="${TAILGATE_ENV_FILE:-.env}"
COMPOSE_ARGS=(compose)
if [[ -n "${TAILGATE_ENV_FILE+x}" || -f "$ENV_FILE" ]]; then
  COMPOSE_ARGS+=(--env-file "$ENV_FILE")
fi

compose() { docker "${COMPOSE_ARGS[@]}" "$@"; }

COMPOSE_ENV=""
if command -v docker >/dev/null 2>&1; then
  COMPOSE_ENV="$(compose config --environment 2>/dev/null || true)"
fi

config_value() {
  local key="$1" line
  while IFS= read -r line; do
    if [[ "$line" == "$key="* ]]; then
      printf '%s' "${line#*=}"
      return 0
    fi
  done <<<"$COMPOSE_ENV"
  return 1
}

resolved_config() {
  local key="$1" inherited="$2" fallback="$3" value
  if value="$(config_value "$key")" && [[ -n "$value" ]]; then
    printf '%s' "$value"
  elif [[ -n "$inherited" ]]; then
    printf '%s' "$inherited"
  else
    printf '%s' "$fallback"
  fi
}

SOCKS5_PORT="$(resolved_config TS_SOCKS5_PORT "${TS_SOCKS5_PORT-}" 1055)"
HTTP_PROXY_PORT="$(resolved_config TS_HTTP_PROXY_PORT "${TS_HTTP_PROXY_PORT-}" 1056)"
LOGIN_SERVER="$(resolved_config TS_LOGIN_SERVER "${TS_LOGIN_SERVER-}" https://headscale.example.com)"
TS_MODE="$(resolved_config TS_MODE "${TS_MODE-}" userspace)"
TAILNET_SUFFIX="$(resolved_config TAILGATE_TAILNET_SUFFIX "${TAILGATE_TAILNET_SUFFIX-}" ts.example.com)"
DNS_TEST_NAME="$(resolved_config TAILGATE_DNS_TEST_NAME "${TAILGATE_DNS_TEST_NAME-}" '')"
FORCE_DERP="$(resolved_config TS_DEBUG_ALWAYS_USE_DERP "${TS_DEBUG_ALWAYS_USE_DERP-}" false)"
AUTHKEY="$(resolved_config TS_AUTHKEY "${TS_AUTHKEY-}" '')"
case "$TS_MODE" in
  userspace|kernel) ;;
  *) echo "invalid TS_MODE '$TS_MODE' (must be 'userspace' or 'kernel')" >&2; exit 1;;
esac
case "$FORCE_DERP" in
  true|false) ;;
  *) echo "invalid TS_DEBUG_ALWAYS_USE_DERP '$FORCE_DERP' (must be 'true' or 'false')" >&2; exit 1;;
esac
SOCKS5_ADDR="127.0.0.1:${SOCKS5_PORT}"
# Selects which compose service (and thus which profile) runs — the two modes
# are mutually exclusive, never both up at once. See compose.yaml for the tradeoffs.
SERVICE="tailscale-${TS_MODE}"
export COMPOSE_PROFILES="${TS_MODE}"

err()  { printf '\033[31m%s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[32m%s\033[0m\n' "$*"; }
info() { printf '%s\n' "$*"; }

require_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    err "No configuration found. Run:  cp .env.example .env  &&  ./bin/mint-authkey --write-env"
    exit 1
  fi
  if [[ -z "$AUTHKEY" ]]; then
    err "TS_AUTHKEY is empty. Run:  ./bin/mint-authkey --write-env"
    exit 1
  fi
}

cmd_up() {
  require_env
  info "Starting tailgate (${TS_MODE} mode — SOCKS5 ${SOCKS5_ADDR}, HTTP 127.0.0.1:${HTTP_PROXY_PORT})"
  [[ "$TS_MODE" == "kernel" ]] && info "kernel mode is EXPERIMENTAL — see the note at the top of compose.yaml"
  compose up -d
  info "Watch registration with:  tailgate logs    (Ctrl-C to stop watching)"
}

cmd_down()   { compose down "$@"; }
cmd_logs()   { compose logs -f "$SERVICE"; }
cmd_status() { compose exec "$SERVICE" tailscale status "$@"; }
cmd_ip()     { compose exec "$SERVICE" tailscale ip "$@"; }

validate_ssh_target() {
  local target="$1" candidate="$1"
  # ProxyCommand is interpreted by a shell after OpenSSH expands %h. Permit
  # host syntax that SSH accepts while rejecting shell metacharacters before
  # the target can reach that command string.
  candidate="${candidate//\[/}"
  candidate="${candidate//\]/}"
  if [[ "$candidate" == -* || -z "$candidate" || ! "$candidate" =~ ^[[:alnum:]_.@:%+_-]+$ ]]; then
    err "host contains unsupported shell characters: '$target'"
    return 1
  fi
}

reject_ssh_option_cluster() {
  local option="$1"
  # Keep attached arguments such as -iKEY and -Lspec valid, but fail closed
  # for clusters like -vi whose parsing could otherwise shift the host.
  if [[ "$option" =~ ^-[[:alpha:]][[:alpha:]]+$ && ! "$option" =~ ^-(B|b|c|D|E|F|I|i|J|L|l|m|O|o|p|Q|R|S|W|w|X|x).+$ ]]; then
    err "combined SSH option clusters are unsupported; use separate options: '$option'"
    return 1
  fi
}

ssh_option_takes_arg() {
  case "$1" in
    -B|-b|-c|-D|-E|-F|-I|-i|-J|-L|-l|-m|-O|-o|-p|-Q|-R|-S|-W|-w|-X|-x|-e)
      return 0 ;;
    *)  return 1 ;;
  esac
}

find_ssh_target() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    shift
    if [[ "$arg" == "--" ]]; then
      if [[ $# -eq 0 ]]; then
        err "ssh target is missing after '--'"
        return 1
      fi
      SSH_TARGET="$1"
      return 0
    fi
    if [[ "$arg" == -* && "$arg" != "-" ]]; then
      reject_ssh_option_cluster "$arg" || return 1
      if ssh_option_takes_arg "$arg"; then
        if [[ $# -eq 0 ]]; then
          err "ssh option '$arg' requires an argument"
          return 1
        fi
        shift
      fi
      continue
    fi
    SSH_TARGET="$arg"
    return 0
  done
  err "ssh target is missing"
  return 1
}

validate_forward_ssh_args() {
  local arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    shift
    if [[ "$arg" == "--" ]]; then
      if [[ $# -gt 0 ]]; then
        err "unexpected positional SSH argument after '--': '$1'"
        return 1
      fi
      return 0
    fi
    if [[ "$arg" == "-" || "$arg" != -* ]]; then
      err "unexpected positional SSH argument: '$arg'"
      return 1
    fi
    if ssh_option_takes_arg "$arg"; then
      if [[ $# -eq 0 ]]; then
        err "ssh option '$arg' requires an argument"
        return 1
      fi
      shift
    fi
  done
}

cmd_ssh() {
  if [[ $# -lt 1 ]]; then err "usage: tailgate ssh [ssh args...] <host>"; exit 1; fi
  find_ssh_target "$@" || exit 1
  validate_ssh_target "$SSH_TARGET" || exit 1
  # nc -X 5 -x <proxy> performs SOCKS5; the hostname is resolved at the proxy,
  # so MagicDNS names (*.ts.example.com) work. If your nc resolves locally,
  # pass the 100.x address instead.
  ssh -o ProxyCommand="nc -X 5 -x ${SOCKS5_ADDR} %h %p" "$@"
}

cmd_curl() {
  curl --proxy "socks5h://${SOCKS5_ADDR}" "$@"
}

parse_forward_endpoint() {
  # Sets FORWARD_ADDRESS and FORWARD_PORT. Addresses containing colons must use
  # brackets so the endpoint remains unambiguous.
  local endpoint="$1" default_address="$2" role="$3"
  local address port colons
  FORWARD_ADDRESS="$default_address"
  FORWARD_PORT=""

  if [[ "$endpoint" =~ ^[0-9]+$ ]]; then
    port="$endpoint"
  elif [[ "$endpoint" == \[* ]]; then
    if [[ "$endpoint" =~ ^\[([^][]+)\]:([0-9]+)$ ]]; then
      address="${BASH_REMATCH[1]}"
      port="${BASH_REMATCH[2]}"
    else
      err "$role endpoint '$endpoint' is malformed; use <address>:<port> or [<IPv6-address>]:<port>"
      return 1
    fi
  elif [[ "$endpoint" == *:* ]]; then
    colons="${endpoint//[^:]/}"
    if [[ ${#colons} -ne 1 ]]; then
      err "$role endpoint '$endpoint': IPv6 addresses must use bracketed syntax ([address]:port)"
      return 1
    fi
    address="${endpoint%:*}"
    port="${endpoint##*:}"
    if [[ -z "$address" ]]; then
      err "$role endpoint address must not be empty (got '$endpoint')"
      return 1
    fi
    if ! [[ "$port" =~ ^[0-9]+$ ]]; then
      err "$role endpoint port must be numeric (got '$port')"
      return 1
    fi
  else
    err "$role endpoint '$endpoint' is malformed; use a port or <address>:<port>"
    return 1
  fi

  FORWARD_ADDRESS="${address:-$default_address}"
  FORWARD_PORT="$port"
}

forward_ssh_address() {
  if [[ "$1" == *:* ]]; then
    printf '[%s]' "$1"
  else
    printf '%s' "$1"
  fi
}

forward_display_address() {
  if [[ "$1" == *:* ]]; then
    printf '[%s]' "$1"
  else
    printf '%s' "$1"
  fi
}

resolve_forward_ts_address() {
  local host="$1" ssh_config ssh_hostname resolver_name address
  shift

  if ! ssh_config="$(ssh -G "$@" "$host" 2>/dev/null)"; then
    err "ts endpoint: could not read SSH configuration for '$host'"
    return 1
  fi
  ssh_hostname="$(awk '$1 == "hostname" { print $2; exit }' <<<"$ssh_config")"
  if [[ -z "$ssh_hostname" ]]; then
    err "ts endpoint: SSH configuration for '$host' has no hostname"
    return 1
  fi

  # SSH aliases are commonly a single node name. The SOCKS shim resolves
  # configured Tailnet names only, so make its DNS suffix explicit.
  resolver_name="$ssh_hostname"
  if [[ "$resolver_name" != *.* && "$resolver_name" != *:* ]]; then
    resolver_name="${resolver_name}.${TAILNET_SUFFIX}"
  fi

  if ! address="$(compose exec -T "$SERVICE" tailgate-socks --resolve "$resolver_name" 2>&1)"; then
    err "ts endpoint: could not resolve SSH host '$resolver_name' through Tailgate DNS"
    [[ -n "$address" ]] && err "$address"
    return 1
  fi
  printf '%s' "$address"
}

cmd_forward() {
  # Forward a service on a tailnet node to a local listener, tunneled through
  # the SOCKS5 proxy. Remote endpoints default to node loopback; `ts` resolves
  # the configured SSH target through Tailgate DNS to reach its Tailnet address.
  #
  # Host is [user@]host, exactly like ssh: a bare alias resolves via ~/.ssh/config,
  # or give user@host plus any ssh flags (e.g. -i key) and need no config at all.
  #
  #   tailgate forward myhost 8000
  #   tailgate forward myhost ts:8000
  #   tailgate forward myhost 100.64.0.8:8000 127.0.0.1:28789 -i ~/.ssh/key
  #   tailgate forward myhost [fd7a::12]:8000 [::1]:28789
  if [[ $# -lt 2 ]]; then
    err "usage: tailgate forward [user@]host [<remote-addr>:]<remote-port> [[<local-addr>:]local-port] [ssh args...]"
    exit 1
  fi
  local host="$1" remote_endpoint local_endpoint
  local remote_address remote_port local_address local_port local_display remote_display
  validate_ssh_target "$host" || exit 1
  shift
  remote_endpoint="$1"; shift
  parse_forward_endpoint "$remote_endpoint" "127.0.0.1" "remote" || exit 1
  remote_address="$FORWARD_ADDRESS"
  remote_port="$FORWARD_PORT"

  local_address="127.0.0.1"
  local_port="$remote_port"
  # An endpoint-shaped next argument selects the local listener. SSH options
  # begin with '-' and remain untouched with the arguments that follow them.
  if [[ "${1:-}" != -* && ( "${1:-}" =~ ^[0-9]+$ || "${1:-}" == *:* || "${1:-}" == \[* ) ]]; then
    local_endpoint="$1"; shift
    parse_forward_endpoint "$local_endpoint" "127.0.0.1" "local" || exit 1
    local_address="$FORWARD_ADDRESS"
    local_port="$FORWARD_PORT"
  elif [[ -n "${1:-}" && "${1:-}" != -* ]]; then
    err "local endpoint '$1' is malformed; use a port or <address>:<port>, or begin SSH arguments with '-'"
    exit 1
  fi
  validate_forward_ssh_args "$@" || exit 1

  if [[ "$remote_address" == "ts" ]]; then
    remote_address="$(resolve_forward_ts_address "$host" "$@")" || exit 1
  fi

  if [[ "$local_address" == "127.0.0.1" ]]; then
    local_display="localhost"
  else
    local_display="$(forward_display_address "$local_address")"
  fi
  remote_display="$(forward_display_address "$remote_address")"
  info "Forwarding http://${local_display}:${local_port}  ->  ${host}:${remote_display}:${remote_port}  (Ctrl-C to stop)"
  # Remaining "$@" are passthrough ssh args; host goes last.
  ssh -N -o ExitOnForwardFailure=yes \
    -o ProxyCommand="nc -X 5 -x ${SOCKS5_ADDR} %h %p" \
    -L "$(forward_ssh_address "$local_address"):${local_port}:$(forward_ssh_address "$remote_address"):${remote_port}" \
    "$@" "$host"
}

cmd_proxy() {
  cat <<EOF
SOCKS5 proxy : socks5h://${SOCKS5_ADDR}
HTTP proxy   : http://127.0.0.1:${HTTP_PROXY_PORT}
               (tailscaled backend; Headscale extra records require SOCKS5)

Shell (curl, git, etc. — remote DNS via SOCKS):
  unset HTTPS_PROXY https_proxy
  export ALL_PROXY=socks5h://${SOCKS5_ADDR}

Browser (Firefox profile): SOCKS5 host 127.0.0.1 port ${SOCKS5_PORT},
  and enable "Proxy DNS when using SOCKS v5".

SSH (~/.ssh/config):
  Host *.${TAILNET_SUFFIX} 100.64.*
    ProxyCommand nc -X 5 -x ${SOCKS5_ADDR} %h %p
EOF
}

cmd_doctor() {
  local fail=0 container_running=false
  command -v docker >/dev/null && ok "✓ docker present" || { err "✗ docker not found"; fail=1; }
  if [[ -f "$ENV_FILE" ]] && [[ -n "$AUTHKEY" ]]; then ok "✓ configuration has TS_AUTHKEY"
  else err "✗ configuration missing or TS_AUTHKEY empty"; fail=1; fi

  info "mode: ${TS_MODE}"
  if [[ "$FORCE_DERP" == "true" ]]; then
    info "forced DERP enabled (debug setting; relay latency applies)"
  fi

  if docker ps --format '{{.Names}}' | grep -qx tailgate; then
    container_running=true
    ok "✓ container 'tailgate' running"
  else
    err "✗ container not running (try: tailgate up)"; fail=1
  fi

  if [[ "$container_running" == "true" ]]; then
    if compose exec -T "$SERVICE" sh -c 'pidof tailgate-socks >/dev/null && pidof tailscaled >/dev/null'; then
      ok "✓ tailgate processes running"
    else
      err "✗ tailgate processes are not healthy (check: tailgate logs)"; fail=1
    fi

    if compose exec -T "$SERVICE" tailscale status --json 2>/dev/null \
      | grep -Eq '"BackendState"[[:space:]]*:[[:space:]]*"Running"'; then
      ok "✓ node registered to ${LOGIN_SERVER}"
      compose exec -T "$SERVICE" tailscale ip 2>/dev/null | sed 's/^/    ip: /' || true
    else
      err "✗ tailscale not registered yet (check: tailgate logs)"; fail=1
    fi

    if compose exec -T "$SERVICE" nc -z 127.0.0.1 1057 >/dev/null 2>&1; then
      ok "✓ tailscaled SOCKS backend reachable on 127.0.0.1:1057"
    else
      err "✗ tailscaled SOCKS backend not reachable on 127.0.0.1:1057"; fail=1
    fi

    if [[ -n "$DNS_TEST_NAME" ]]; then
      if compose exec -T "$SERVICE" tailgate-socks --resolve "$DNS_TEST_NAME" >/dev/null 2>&1; then
        ok "✓ internal alias resolves: ${DNS_TEST_NAME}"
      else
        err "✗ internal alias does not resolve: ${DNS_TEST_NAME}"; fail=1
      fi
    else
      info "internal alias check skipped (set TAILGATE_DNS_TEST_NAME to enable)"
    fi
  fi

  if nc -z 127.0.0.1 "${SOCKS5_PORT}" 2>/dev/null; then
    ok "✓ DNS-aware SOCKS shim reachable on ${SOCKS5_ADDR}"
  else
    err "✗ DNS-aware SOCKS shim not reachable on ${SOCKS5_ADDR}"; fail=1
  fi

  [[ $fail -eq 0 ]] && ok "doctor: all good" || { err "doctor: problems found"; return 1; }
}

usage() { sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    up)      cmd_up "$@";;
    down)    cmd_down "$@";;
    status)  cmd_status "$@";;
    ip)      cmd_ip "$@";;
    logs)    cmd_logs "$@";;
    ssh)     cmd_ssh "$@";;
    curl)    cmd_curl "$@";;
    forward) cmd_forward "$@";;
    proxy)   cmd_proxy "$@";;
    doctor)  cmd_doctor "$@";;
    ""|-h|--help|help) usage;;
    *) err "unknown command: $sub"; usage; exit 1;;
  esac
}

main "$@"
